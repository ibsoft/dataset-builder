# Copy to .env, never commit the real file. Generate via: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Optional RAG integration: generate a dedicated key using
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this stable, secret, and backed up separately from the database.
RAG_ENCRYPTION_KEY=
# Development only: SQLite, single host / light traffic
# DATABASE_URL=sqlite:////absolute/path/to/datasetbuilder.sqlite  # Defaults to project/data/*.sqlite
# Shared persistent directory for Markdown mirrors and file locking
KB_DIRECTORY=./data/knowledge_base
KB_PADDING=2
# Production behind TLS reverse proxy only: 1
COOKIE_SECURE=0
# Flask-Limiter: production multi-worker deployments must use Redis
RATELIMIT_STORAGE_URI=memory://

# Docker Compose PostgreSQL credential. Use a URL-safe random value.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
